

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  DONOR
  DOCTOR
  ADMIN
}

enum BloodType {
  A_POSITIVE  // A+
  A_NEGATIVE  // A-
  B_POSITIVE  // B+
  B_NEGATIVE  // B-
  AB_POSITIVE // AB+
  AB_NEGATIVE // AB-
  O_POSITIVE  // O+
  O_NEGATIVE  // O-
}

enum DonationType {
  BLOOD       // Цус
  PLASMA      // Сийвэн
  ORGAN       // Эрхтэн
  TISSUE      // Эд эс
}

enum RequestPriority {
  NORMAL
  URGENT
  EMERGENCY_SOS
}

enum RequestStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum DonationStatus {
  PENDING    // Donor applied
  ACCEPTED   // Doctor scheduled an appointment
  REJECTED   // Doctor declined the application
  COMPLETED  // Donation was physically performed
  CANCELLED  // Donor or Doctor cancelled
}
model User {
  id               String           @id @default(uuid())
  clerkUserId      String           @unique
  email            String           @unique
  fullName         String
  phone            String?
  role             Role             @default(DONOR)
  bloodType        BloodType?
  city             String?
  isAvailable      Boolean          @default(true)
  isProfileComplete Boolean         @default(false)
  lastDonatedAt    DateTime?
  donationTypes    DonationType[]
  isDoctorVerified Boolean          @default(false)
  hospitalName     String?
  donations        DonationRecord[]
  doctorRequests   MedicalRequest[] @relation("DoctorRequests")
  targetedRequests MedicalRequest[] @relation("TargetedRequests")
  receivedBadges   UserBadge[]
  notifications    Notification[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
model DonationRecord {
  id              String          @id @default(uuid())
  requestId       String?
  request         MedicalRequest? @relation(fields: [requestId], references: [id])
  donorId         String
  donor           User            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  type            DonationType
  status          DonationStatus  @default(PENDING)
  appointmentNote String?
  rejectionReason String?
  rating          Int?
  feedback        String?
  notes           String?
  donatedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
model MedicalRequest {
  id           String          @id @default(uuid())
  doctorId     String
  doctor       User            @relation("DoctorRequests", fields: [doctorId], references: [id])
  targetUserId String?
  targetUser   User?           @relation("TargetedRequests", fields: [targetUserId], references: [id])
  bloodType    BloodType?
  type         DonationType
  priority     RequestPriority @default(NORMAL)
  status       RequestStatus   @default(PENDING)
  title        String
  description  String
  hospital     String
  donations    DonationRecord[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}
model Badge {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String
  iconUrl     String
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}